# ── Look & feel ────────────────────────────────────────────────
# Whole design: classic | midnight | rose | letterpress | noor
#   classic      the original lavender watercolour design
#   midnight     Mughal night garden: indigo, gold leaf, night sky
#   rose         Redouté roses & saffron on maroon velvet
#   letterpress  ivory cotton paper, one ink, gold foil
#   noor         a self-playing film: gold light writing over a lamp-lit room with the Qur'an
# Each theme sets sensible defaults for the switches below; anything you
# set explicitly here wins. Leave a switch empty to use the theme default.
VITE_THEME=noor

# Envelope: 3d (lit three.js envelope) | classic (CSS envelope)
VITE_ENVELOPE=off

# three.js night sky behind the pages, lanterns light up as you scroll: on | off
VITE_SKY=off

# Gold lettering catches the light as the phone tilts: on | off
VITE_FOIL=off

# Recited dua after opening: rabbirhamhuma | rabbana-hablana | off
VITE_DUA=rabbirhamhuma
# Start it with the seal tap (on), or only via its play button (off)
VITE_DUA_AUTOPLAY=on

# Greet the guest from the link: …/?to=Rahman%20Family  → on | off
VITE_GUEST_NAME=on

# "Add to calendar" buttons on the event cards: on | off
VITE_CALENDAR=on

# Short vibration on the seal tap (Android): on | off
VITE_HAPTICS=on

# The site's public address (no trailing slash). WhatsApp needs it to show
# the preview image, e.g. https://dz-nikah.example.com
VITE_SITE_URL=https://md-invitation.vercel.app

# ── Invitation effects ─────────────────────────────────────────
# Copy to `.env` (or `.env.local`) and change values; restart `yarn dev`
# / rebuild after changing. There is no settings UI on the site.

# Touch / tap effect: petals | sparks | ripple | mehndi | none
VITE_TOUCH_EFFECT=petals

# Petals drifting across the screen at any one time (0 = off, max 150)
VITE_AMBIENT_PETALS=50

# Petal colour (ambient + touch petals); empty = the theme's colours. A name — lavender, pink, rose, red,
# maroon, peach, gold, white, purple — or any hex code like #e05a7a.
# Comma-separate to mix colours, e.g. red,white  or  #e05a7a,#f4efe6
VITE_PETAL_COLOR=rose

# Golden lantern lights floating upward at any one time (0 = off, max 30)
VITE_AMBIENT_LANTERNS=0

# Opening: seal (tap the wax seal to open the envelope) | auto (opens by itself)
VITE_OPENING=seal
